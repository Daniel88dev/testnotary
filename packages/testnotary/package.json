{
  "name": "testnotary",
  "version": "0.0.0",
  "description": "Run a declared test suite on a clean tree and attest the pass, so CI can skip its tests.",
  "license": "MIT",
  "homepage": "https://testnotary.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel88dev/testnotary.git",
    "directory": "packages/testnotary"
  },
  "type": "module",
  "bin": {
    "testnotary": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "node ../../scripts/release/build.ts library",
    "prepack": "node ../../scripts/release/build.ts library"
  },
  "devDependencies": {
    "@testnotary/core": "workspace:*",
    "@testnotary/protocol": "workspace:*",
    "@testnotary/test-world": "workspace:*",
    "zod": "^4.6.7"
  }
}
