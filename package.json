{
  "name": "testnotary-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p .",
    "test": "pnpm test:world && pnpm test:browser",
    "test:world": "vitest run",
    "test:browser": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @testnotary/web db:migrate",
    "db:generate": "pnpm --filter @testnotary/web db:generate",
    "schema:write": "node packages/core/scripts/write-config-schema.ts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testnotary/core": "workspace:*",
    "@testnotary/protocol": "workspace:*",
    "@testnotary/test-world": "workspace:*",
    "@types/node": "^24.19.2",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
