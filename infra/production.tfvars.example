# Copy to production.tfvars (ignored by git) and fill in. Never commit the filled copy.

vpc_id             = "vpc-…"
private_subnet_ids = ["subnet-…", "subnet-…"]

# "dedicated" until the runbook's check of ADR 0002's launch conditions passes.
database = "dedicated"
